{
	"$schema": "https://schemas.wp.org/wp/6.5/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{
					"slug": "branco",
					"name": "Branco",
					"color": "#FFFFFF"
				},
				{
					"slug": "espuma",
					"name": "Espuma",
					"color": "#F3F9FA"
				},
				{
					"slug": "agua",
					"name": "Água clara",
					"color": "#E3F2F3"
				},
				{
					"slug": "aqua",
					"name": "Aqua (cabeçalho do site atual)",
					"color": "#A8D7DC"
				},
				{
					"slug": "turquesa",
					"name": "Turquesa (botões)",
					"color": "#04BDC7"
				},
				{
					"slug": "faixa",
					"name": "Turquesa faixa",
					"color": "#10B0B9"
				},
				{
					"slug": "titulo",
					"name": "Teal títulos",
					"color": "#0397AB"
				},
				{
					"slug": "teal",
					"name": "Teal Nautic Squad",
					"color": "#09848F"
				},
				{
					"slug": "tinta",
					"name": "Tinta (texto)",
					"color": "#0B3A40"
				},
				{
					"slug": "cinza",
					"name": "Cinza azulado",
					"color": "#557479"
				},
				{
					"slug": "abismo",
					"name": "Abismo (rodapé)",
					"color": "#042A2F"
				}
			],
			"gradients": [
				{
					"slug": "profundidade",
					"name": "Profundidade",
					"gradient": "linear-gradient(180deg,#042A2F 0%,#06404A 60%,#09848F 100%)"
				},
				{
					"slug": "lagoa",
					"name": "Lagoa",
					"gradient": "linear-gradient(135deg,#09848F 0%,#04BDC7 100%)"
				}
			]
		},
		"typography": {
			"fluid": true,
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"slug": "titulos",
					"name": "Plus Jakarta Sans",
					"fontFamily": "\"Plus Jakarta Sans\", ui-sans-serif, system-ui, sans-serif"
				},
				{
					"slug": "texto",
					"name": "Inter",
					"fontFamily": "\"Inter\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif"
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Pequeno",
					"size": "0.875rem",
					"fluid": false
				},
				{
					"slug": "medium",
					"name": "Médio",
					"size": "1.0625rem",
					"fluid": false
				},
				{
					"slug": "large",
					"name": "Grande",
					"size": "1.375rem",
					"fluid": {
						"min": "1.2rem",
						"max": "1.5rem"
					}
				},
				{
					"slug": "x-large",
					"name": "Muito grande",
					"size": "2.5rem",
					"fluid": {
						"min": "1.9rem",
						"max": "3rem"
					}
				},
				{
					"slug": "huge",
					"name": "Enorme",
					"size": "7rem",
					"fluid": {
						"min": "3.4rem",
						"max": "9.5rem"
					}
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"em",
				"rem",
				"vh",
				"vw",
				"%"
			],
			"spacingSizes": [
				{
					"slug": "20",
					"name": "XS",
					"size": "0.5rem"
				},
				{
					"slug": "30",
					"name": "S",
					"size": "1rem"
				},
				{
					"slug": "40",
					"name": "M",
					"size": "1.5rem"
				},
				{
					"slug": "50",
					"name": "L",
					"size": "clamp(2rem, 4vw, 3rem)"
				},
				{
					"slug": "60",
					"name": "XL",
					"size": "clamp(3rem, 7vw, 6rem)"
				},
				{
					"slug": "70",
					"name": "XXL",
					"size": "clamp(4.5rem, 10vw, 9rem)"
				}
			]
		},
		"layout": {
			"contentSize": "760px",
			"wideSize": "1320px"
		},
		"custom": {
			"radius": {
				"s": "10px",
				"m": "18px",
				"l": "28px"
			},
			"shadow": {
				"card": "0 18px 50px -20px rgba(7,26,44,.35)"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--branco)",
			"text": "var(--wp--preset--color--tinta)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--texto)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65"
		},
		"spacing": {
			"padding": {
				"left": "clamp(1rem, 4vw, 2.5rem)",
				"right": "clamp(1rem, 4vw, 2.5rem)"
			},
			"blockGap": "1.25rem"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--titulos)",
					"fontWeight": "600",
					"lineHeight": "1.05",
					"letterSpacing": "-0.035em"
				},
				"color": {
					"text": "var(--wp--preset--color--tinta)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--huge)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--teal)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--turquesa)"
					}
				}
			},
			"button": {
				"border": {
					"radius": "999px"
				},
				"color": {
					"background": "var(--wp--preset--color--turquesa)",
					"text": "var(--wp--preset--color--branco)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--texto)",
					"fontWeight": "600",
					"fontSize": "0.95rem",
					"letterSpacing": "0",
					"textTransform": "none"
				},
				"spacing": {
					"padding": {
						"top": "1rem",
						"bottom": "1rem",
						"left": "1.6rem",
						"right": "1.15rem"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--teal)",
						"text": "var(--wp--preset--color--branco)"
					}
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Cabeçalho",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Rodapé",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "page-full",
			"title": "Página larga (sem título)",
			"postTypes": [
				"page"
			]
		}
	]
}